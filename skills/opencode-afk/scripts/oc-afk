#!/usr/bin/env bash
# oc-afk - drive one OpenCode session unattended, on this host or another host.
#
# Usage:
#   oc-afk <project-dir> <session-title> <prompt...>
#   oc-afk --bg <project-dir> <session-title> <prompt...>
#   oc-afk --notify <project-dir> <session-title> <prompt...>
#   oc-afk --host <ssh-host> <project-dir> <session-title> <prompt...>
#
# A session is identified by an exact title inside the project and is created on
# the first run, so one title is one durable session.
#
# Model: the OpenCode configuration of the host that runs the job decides the
# model. Set OC_MODEL to override it.
set -euo pipefail

# ssh sessions and systemd units often start with a bare PATH.
for dir in "$HOME/.local/bin" /opt/homebrew/bin /usr/local/bin "$HOME/.linuxbrew/bin"; do
    if [ -d "$dir" ]; then
        case ":$PATH:" in
            *":$dir:"*) ;;
            *) PATH="$dir:$PATH" ;;
        esac
    fi
done
export PATH

readonly STATE_DIR="${OC_STATE_DIR:-$HOME/.local/state/oc-afk}"
readonly SIGNAL_TARGET="${OC_SIGNAL_TARGET:-signal}"
readonly ANSWER_LIMIT=3500
readonly REMOTE_SELF='$HOME/.agents/skills/opencode-afk/scripts/oc-afk'

notify=0
background=0
host=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --notify)
            notify=1
            shift
            ;;
        --bg)
            background=1
            shift
            ;;
        --host)
            host="${2:-}"
            if [ -z "$host" ]; then
                echo "oc-afk: --host needs an ssh host" >&2
                exit 2
            fi
            shift 2
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "oc-afk: unknown option $1" >&2
            exit 2
            ;;
        *)
            break
            ;;
    esac
done

if [ -n "$host" ]; then
    if [ "$background" = 1 ]; then
        echo "oc-afk: --host does not support --bg" >&2
        exit 2
    fi
    model_env=""
    if [ -n "${OC_MODEL:-}" ]; then
        printf -v model_env 'OC_MODEL=%q ' "$OC_MODEL"
    fi
    printf -v remote_args '%q ' "$@"
    exec ssh -o BatchMode=yes "$host" "${model_env}${REMOTE_SELF} ${remote_args}"
fi

if [ "$#" -lt 3 ]; then
    echo "usage: oc-afk [--bg] [--notify] [--host <host>] <project-dir> <session-title> <prompt...>" >&2
    exit 2
fi

readonly PROJECT="$1"
readonly TITLE="$2"
shift 2
readonly PROMPT="$*"

# shellcheck disable=SC2086 # the model flag is a deliberate two-word expansion.
model_arg=""
if [ -n "${OC_MODEL:-}" ]; then
    model_arg="--model $OC_MODEL"
fi

mkdir -p "$STATE_DIR"

if [ "$background" = 1 ]; then
    self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    log="$STATE_DIR/bg-$(date +%Y%m%dT%H%M%S).log"
    nohup "$self" --notify "$PROJECT" "$TITLE" "$PROMPT" >"$log" 2>&1 &
    echo "started pid=$!"
    echo "log=$log"
    exit 0
fi

if [ ! -d "$PROJECT" ]; then
    echo "oc-afk: no such directory: $PROJECT" >&2
    exit 1
fi
cd "$PROJECT"

stamp="$(date +%Y%m%dT%H%M%S)"
readonly RUN_LOG="$STATE_DIR/$stamp.jsonl"
readonly ANSWER="$STATE_DIR/$stamp.answer"

session_id="$(opencode session list --format json -n 200 2>/dev/null | python3 -c '
import json, sys

title = sys.argv[1]
try:
    rows = json.load(sys.stdin)
except json.JSONDecodeError:
    rows = []
for row in rows:
    if row.get("title") == title:
        print(row["id"])
        break
' "$TITLE")"

status=0
if [ -n "$session_id" ]; then
    opencode run $model_arg --auto --format json --session "$session_id" "$PROMPT" >"$RUN_LOG" 2>&1 || status=$?
else
    opencode run $model_arg --auto --format json --title "$TITLE" "$PROMPT" >"$RUN_LOG" 2>&1 || status=$?
fi

python3 - "$RUN_LOG" >"$ANSWER" <<'PY'
import json
import sys

chunks = []
for line in open(sys.argv[1]):
    line = line.strip()
    if not line.startswith("{"):
        continue
    try:
        event = json.loads(line)
    except json.JSONDecodeError:
        continue
    kind = event.get("type")
    if kind == "text":
        text = event.get("part", {}).get("text", "")
        if text:
            chunks.append(text)
    elif kind == "error":
        error = event.get("error", {})
        message = str(error.get("message", ""))[:400]
        chunks.append(f"[error] {error.get('type', 'unknown')}: {message}")

print("\n".join(chunks).strip() or "(no answer text)")
PY

if [ -n "$session_id" ]; then
    echo "session: $session_id (continued)"
else
    echo "session: new, titled \"$TITLE\""
fi
echo "project: $PROJECT"
echo "model: ${OC_MODEL:-host default}"
echo "exit: $status"
echo "log: $RUN_LOG"
echo
cat "$ANSWER"

if [ "$notify" = 1 ]; then
    if command -v hermes >/dev/null 2>&1; then
        {
            echo "project: $PROJECT"
            echo "title: $TITLE"
            echo
            head -c "$ANSWER_LIMIT" "$ANSWER"
        } | hermes send -t "$SIGNAL_TARGET" -s "OpenCode ${TITLE}" || true
    else
        echo "oc-afk: hermes not found, skipped the Signal notification" >&2
    fi
fi

exit "$status"
